# ./Makefile.in			-*- Makefile -*-

DATE = @DATE@
VERSION = @VERSION@
RXVTNAME = @RXVTNAME@
SHELL = /bin/sh
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
libdir = @libdir@
man1dir = @mandir@/man1
man1ext = 1
man3dir = @mandir@/man3
man3ext = 3
man7dir = @mandir@/man7
man7ext = 7
PERL = @PERL@
CXX = @CXX@
CXXFLAGS = @CXXFLAGS@
INSTALL = @INSTALL@
INSTALL_PROGRAM = @INSTALL@ -m 755
INSTALL_DATA = @INSTALL@ -m 644

VERNAME = rxvt-unicode-$(VERSION)

srcdir = @srcdir@
VPATH = @srcdir@

first_rule: all
dummy:

subdirs = src doc

RECURSIVE_TARGETS = all allbin alldoc tags clean distclean realclean install

#-------------------------------------------------------------------------

$(RECURSIVE_TARGETS):
	@for I in $(subdirs); do (cd $$I; $(MAKE) $@) || exit 1; done

distclean realclean: distclean-local

#
# entry points for other programs
#
rxvt:
	(cd src; $(MAKE))

#-------------------------------------------------------------------------
configure: configure.ac aclocal.m4 libev/libev.m4
	cd $(srcdir); ./autogen.sh

config.status:
	if test -x config.status; then config.status --recheck; \
	else $(SHELL) configure; fi

config.h.in: configure.ac aclocal.m4 libev/libev.m4
	cd $(srcdir); ./autogen.sh

check: all
	$(MAKE) check-xterm-compat

check-xterm-compat:
	mkdir -p tests
	$(CXX) $(CXXFLAGS) -I$(srcdir)/src -o tests/xterm-keys $(srcdir)/tests/xterm-keys.C
	tests/xterm-keys
	$(CXX) $(CXXFLAGS) -I$(srcdir)/src -o tests/osc52 $(srcdir)/tests/osc52.C
	tests/osc52
	rm -f tests/xterm-keys tests/osc52
	@if command -v xvfb-run >/dev/null 2>&1 \
	   && command -v xdotool >/dev/null 2>&1 \
	   && command -v xclip >/dev/null 2>&1 \
	   && command -v xprop >/dev/null 2>&1; then \
	  test_srcdir=$$(cd "$(srcdir)" && pwd); \
	  PERL5LIB="$$(pwd)/src:$$test_srcdir/src$${PERL5LIB:+:$$PERL5LIB}" \
	  URXVT_PERL_LIB="$$test_srcdir/src/perl" \
	  xvfb-run -a sh -c '\
	    $(srcdir)/tests/xterm-compat-integration src/rxvt && \
	    $(srcdir)/tests/clipboard-tmux-integration src/rxvt && \
	    python3 $(srcdir)/tests/mouse-reset-integration.py src/rxvt && \
	    python3 $(srcdir)/tests/mouse-reset-integration.py --daemon src/rxvt && \
	    python3 $(srcdir)/tests/mouse-cleanup-integration.py src/rxvt && \
	    python3 $(srcdir)/tests/mouse-cleanup-integration.py --daemon src/rxvt'; \
	else \
	  echo "SKIP X integration tests: Xvfb, xdotool, xclip, or xprop unavailable"; \
	fi

Makefiles:
	$(SHELL) config.status

cleandir: realclean

distclean-local:
	rm -f config.cache config.h config.log config.status
	rm -f Makefile
	rm -f tests/xterm-keys tests/osc52

distdir:
	cd doc && $(MAKE) distdepend
	cd src && $(MAKE) depend
	rm -rf $(VERNAME)
	mkdir $(VERNAME)
	rsync -aR --copy-unsafe-links `cat MANIFEST` $(VERNAME)/.

tar.gz: distdir
	tar cvf - $(VERNAME) | gzip -vf9 > $(VERNAME).tar.gz
	rm -rf $(VERNAME)

tar.bz2: distdir
	tar cvf - $(VERNAME) | bzip2 -vf9 > $(VERNAME).tar.bz2
	rm -rf $(VERNAME)

dist: tar.bz2

# ------------------------------------------------------------------------
