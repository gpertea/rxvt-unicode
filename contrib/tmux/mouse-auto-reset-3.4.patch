+
+static void
+input_clear_mouse(struct input_ctx *ictx)
+{
+	struct input_mouse_state *job;
+
+	event_del(&ictx->mouse_timer);
+	while ((job = ictx->mouse_jobs) != NULL) {
+		ictx->mouse_jobs = job->next;
+		free(job);
+	}
+	ictx->mouse_pgrp = 0;
+}
+
+void
+input_check_mouse(struct window_pane *wp)
+{
+	struct input_ctx *ictx;
+	struct input_mouse_state *job, **link;
+	struct timeval tv = { .tv_usec = 100000 };
+	pid_t foreground;
+	int modes, previous;
+	const int mask = ALL_MOUSE_MODES | MODE_MOUSE_UTF8 | MODE_MOUSE_SGR | MODE_FOCUSON;
+
+	if (wp == NULL || wp->ictx == NULL)
+		return;
+	ictx = wp->ictx;
+	if (!options_get_number(wp->options, "mouse-auto-reset")) {
+		input_clear_mouse(ictx);
+		return;
+	}
+	if (wp->fd == -1) {
+		wp->base.mode &= ~mask;
+		input_clear_mouse(ictx);
+		return;
+	}
+	foreground = tcgetpgrp(wp->fd);
+	if (foreground <= 1)
+		return;
+	previous = wp->base.mode & mask;
+	if (foreground != ictx->mouse_pgrp) {
+		/* save stopped jobs without leaking their modes into the shell. */
+		for (link = &ictx->mouse_jobs; (job = *link) != NULL; ) {
+			if (job->pgrp == ictx->mouse_pgrp) {
+				*link = job->next;
+				free(job);
+			} else
+				link = &job->next;
+		}
+		if (ictx->mouse_pgrp > 1 && previous != 0) {
+			job = xcalloc(1, sizeof *job);
+			job->pgrp = ictx->mouse_pgrp;
+			job->mode = previous;
+			job->next = ictx->mouse_jobs;
+			ictx->mouse_jobs = job;
+		}
+		wp->base.mode &= ~mask;
+		for (job = ictx->mouse_jobs; job != NULL; job = job->next) {
+			if (job->pgrp == foreground) {
+				wp->base.mode |= job->mode;
+				break;
+			}
+		}
+		ictx->mouse_pgrp = foreground;
+	}
+	/* dead process groups cannot resume or restore stale state. */
+	for (link = &ictx->mouse_jobs; (job = *link) != NULL; ) {
+		if (kill(-job->pgrp, 0) == -1 && errno == ESRCH) {
+			*link = job->next;
+			free(job);
+		} else
+			link = &job->next;
+	}
+	if (kill(-ictx->mouse_pgrp, 0) == -1 && errno == ESRCH) {
+		wp->base.mode &= ~mask;
+		ictx->mouse_pgrp = 0;
+	}
+	modes = wp->base.mode & mask;
+	if (modes != previous)
+		wp->flags |= PANE_CHANGED;
+	if (modes != 0 || ictx->mouse_jobs != NULL)
+		evtimer_add(&ictx->mouse_timer, &tv);
+	else
+		event_del(&ictx->mouse_timer);
+}
